    panFrom: {x: 0, y: 0}
    panTo: {x: 0, y: 0}
    duration: 3.6
    speaker: VANCE
    caption: "Estou presa na observa\xE7\xE3o. A Aethelgard ativou a autodestrui\xE7\xE3o
      da base."
    sound: {fileID: 0}
    transition: 0
    memory: 0
    cue: 
