    panTo: {x: 0, y: 0}
    duration: 3.8
    speaker: VANCE
    caption: "Voc\xEA n\xE3o \xE9 auditor. A auditoria \xE9 o teste. Eu apaguei sua
      mem\xF3ria."
    sound: {fileID: 0}
    transition: 0
    memory: 0
    cue: 
  - kind: 1
